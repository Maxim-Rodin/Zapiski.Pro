FROM node:22-alpine AS miniapp-build
WORKDIR /src/miniapp

COPY miniapp/ ./

ARG VITE_API_URL=https://api.app-zapisi-pro.site
ENV VITE_API_URL=$VITE_API_URL
RUN npm ci --no-audit --no-fund --no-progress \
    && npm run build \
    && rm -rf node_modules /root/.npm /tmp/*

FROM node:22-alpine AS landing-build
WORKDIR /src/landing

COPY landing/ ./

RUN npm ci --no-audit --no-fund --no-progress \
    && npm run build \
    && rm -rf node_modules .next .next-dev /root/.npm /tmp/*

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=miniapp-build /src/miniapp/dist /usr/share/nginx/miniapp
COPY --from=landing-build /src/landing/out /usr/share/nginx/landing
